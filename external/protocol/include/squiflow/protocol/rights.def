// Every right in the system. A right is granted to a person directly; there
// are no roles. Retired rights are never reused, so an old grant can never
// silently become a grant of something else.
//
// SQF_RIGHT(name, module)

SQF_RIGHT(right_person_manage,         administration)
SQF_RIGHT(right_rights_grant,          administration)
SQF_RIGHT(right_device_manage,         administration)
